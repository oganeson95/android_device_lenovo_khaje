LOCAL_PATH := device/lenovo/khaje

PRODUCT_SHIPPING_API_LEVEL := 33
PRODUCT_EXTRA_VNDK_VERSIONS := 33

# Captured stock logical density; SurfaceFlinger physical DPI is a different value.
PRODUCT_VENDOR_PROPERTIES += ro.sf.lcd_density=240

# These enable the partition model; group sizing and OTA membership are blocked.
PRODUCT_USE_DYNAMIC_PARTITIONS := true

# Generated by the selective, hash-pinned extract-utils flow, not a stock vendor image.
$(call inherit-product, vendor/lenovo/khaje/khaje-vendor.mk)
